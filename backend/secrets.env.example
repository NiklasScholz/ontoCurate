OPENAI_API_BASE=your-api-url
OPENAI_API_KEY=your-api-key
EMBEDDING_MODEL=qwen3-embedding-8b
MAX_TEXT_LENGTH=100000
MAX_OUTPUT_TOKENS=16000
# Lower values favor consistently extracting every list entry over creative variation
EXTRACTION_TEMPERATURE=0.3
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
WIKIMEDIA_USER_AGENT=your-app-name/1.0 (https://your-contact-url-or-email)
CORS_ALLOW_ORIGINS=["http://localhost:5173","https://ontocurate.app","https://www.ontocurate.app"]
# "production" disables problematic pages for security (e.g., swagger page)
ENVIRONMENT=development
SECRET_KEY=change-me-in-production